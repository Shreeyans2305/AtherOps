# AtherOps Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# CLERK AUTHENTICATION
# Get these from https://dashboard.clerk.com/last-active?path=api-keys
# ============================================================================

CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_CLERK_SECRET_KEY

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# Local development (SQLite)
DATABASE_URL=sqlite:///./atherops.db

# Production (Supabase/PostgreSQL) - uncomment and configure when ready
# DATABASE_URL=YOUR_DATABASE_CONNECTION_STRING


# ============================================================================
# SMTP EMAIL CONFIGURATION
# For sending actual emails on critical/high-risk issues
# ============================================================================

# SMTP Server Settings
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# SMTP Credentials
# For Gmail, use an App Password (not your regular password)
# Go to Google Account > Security > 2-Step Verification > App passwords
SMTP_EMAIL=SENDER_EMAIL
SMTP_PASSWORD=YOUR_SMTP_PASSWORD

# ============================================================================
# NOTIFICATION RECIPIENTS
# ============================================================================

# Comma-separated list of engineer emails for escalations
ENGINEER_EMAILS=ENGINEER_EMAIL

# Default merchant support email
MERCHANT_SUPPORT_EMAIL=SUPPORT_EMAIL

# ============================================================================
# JIRA INTEGRATION (Future - not yet implemented)
# ============================================================================

# JIRA_BASE_URL=https://your-domain.atlassian.net
# JIRA_API_TOKEN=your-api-token
# JIRA_PROJECT_KEY=PROJ
# JIRA_USER_EMAIL=your-jira-email@company.com
